# Polymarket V2 trader credentials — COPY to ".env" and fill in.
# The real .env is gitignored and must NEVER be committed (it holds a live
# wallet private key). Transfer the real .env between machines by USB, not git.

# Owner EOA (created by: python polymarket_setup.py --new-wallet)
POLY_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HEX
POLY_ADDRESS=0xYourEoaAddress

# CLOB API creds (python polymarket_setup.py --step keys)
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=

# Builder (relayer) creds — self-minted during --step keys
POLY_BUILDER_API_KEY=
POLY_BUILDER_SECRET=
POLY_BUILDER_PASSPHRASE=

# Deposit wallet (deployed by --step deposit). This is the maker/funder on V2.
POLY_DEPOSIT_WALLET=0xYourDepositWalletProxy

# Optional: default bankroll for run_trader.py
# POLY_BANKROLL=23

# ─── Pipeline Phase 3 — information edge (LLM layer) ───
# Sonnet estimator + Opus decision layer. TWO ways to power them (auto-selected):
#   1. API KEY (best for full-auto: fast, cheap per call):
#        ANTHROPIC_API_KEY=sk-ant-...
#   2. NO KEY, via the Claude Code CLI (uses your existing subscription):
#        works automatically if the `claude` binary is installed + logged in.
#        Slower per call (carries Claude Code's system prompt) but $0 extra setup.
# Force a backend if needed: auto (default) | api | cli | off
# PIPELINE_LLM_BACKEND=auto
# Per-run Sonnet call budget (cost control); default 40. Lower it for the CLI backend.
# PIPELINE_LLM_MAX_CALLS=40
# (ANTHROPIC_API_KEY also enables the options-wheel news-sentiment gate.)
